---
// Standalone layout for the /ctf challenge. Does not import the blog's global.css,
// so the personal site's styling is unaffected and vice versa.
interface Props {
	title: string;
	wide?: boolean;
	bodyClass?: string;
}
const { title, wide = false, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
		<meta name="robots" content="noindex,nofollow" />
		<meta name="theme-color" content="#07111f" />
		<link rel="icon" type="image/svg+xml" href="/ctf/shield.svg" />
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<div class="grid-bg" aria-hidden="true"></div>
		<main class:list={['shell', { wide }]}>
			<slot />
		</main>
		<div id="toast" role="status" aria-live="polite"></div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #07111f;
		--bg-2: #0b1a2e;
		--panel: #0f2139;
		--panel-2: #132a47;
		--line: #1f3a5c;
		--line-2: #2b4c75;
		--text: #eaf1fb;
		--muted: #8ea5c4;
		--dim: #5f7898;
		--cyan: #22d3ee;
		--cyan-dim: rgba(34, 211, 238, 0.12);
		--orange: #f59e0b;
		--green: #22c55e;
		--green-dim: rgba(34, 197, 94, 0.12);
		--red: #f87171;
		--red-dim: rgba(248, 113, 113, 0.12);
		--gold: #fbbf24;
		--silver: #cbd5e1;
		--bronze: #d9905a;
		--mono: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', Menlo, Consolas, 'Liberation Mono', monospace;
		--sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		--r: 12px;
		color-scheme: dark;
	}
	* { box-sizing: border-box; }
	html, body { margin: 0; padding: 0; }
	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		font-size: 16px;
		line-height: 1.5;
		min-height: 100vh;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}
	.grid-bg {
		position: fixed; inset: 0; z-index: 0; pointer-events: none;
		background-image:
			linear-gradient(rgba(34, 211, 238, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(34, 211, 238, 0.045) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: radial-gradient(ellipse at 50% 0%, #000 30%, transparent 80%);
	}
	.shell { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; padding: 20px 16px 64px; }
	.shell.wide { max-width: 1600px; padding: 24px 32px; }
	a { color: var(--cyan); }
	h1, h2, h3 { line-height: 1.12; margin: 0; letter-spacing: -0.01em; }
	.mono { font-family: var(--mono); }
	.muted { color: var(--muted); }
	.eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
	.topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; color: var(--muted); text-transform: uppercase; }
	.topbar .brand { display: flex; align-items: center; gap: 8px; color: var(--text); }
	.topbar .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
	.card { background: linear-gradient(180deg, var(--panel), var(--bg-2)); border: 1px solid var(--line); border-radius: var(--r); padding: 20px; }
	.btn {
		display: inline-flex; align-items: center; justify-content: center; gap: 8px;
		min-height: 48px; padding: 12px 20px; border-radius: 10px; border: 1px solid var(--cyan);
		background: var(--cyan); color: #04121f; font-weight: 800; font-size: 15px; letter-spacing: 0.06em;
		text-decoration: none; cursor: pointer; font-family: var(--sans); text-transform: uppercase;
		transition: transform 0.06s ease, filter 0.15s ease, background 0.15s ease;
	}
	.btn:hover { filter: brightness(1.08); }
	.btn:active { transform: translateY(1px); }
	.btn:disabled { opacity: 0.5; cursor: not-allowed; }
	.btn.ghost { background: transparent; color: var(--cyan); }
	.btn.ghost:hover { background: var(--cyan-dim); }
	.btn.warn { background: var(--orange); border-color: var(--orange); }
	.btn.danger { background: transparent; color: var(--red); border-color: var(--red); }
	.btn.block { width: 100%; }
	.btn.sm { min-height: 36px; padding: 6px 12px; font-size: 12px; }
	.pill { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--muted); }
	.pill.ok { color: var(--green); border-color: rgba(34, 197, 94, 0.5); background: var(--green-dim); }
	.pill.live { color: var(--cyan); border-color: rgba(34, 211, 238, 0.5); background: var(--cyan-dim); }
	.pill.warn { color: var(--orange); border-color: rgba(245, 158, 11, 0.5); background: rgba(245, 158, 11, 0.1); }
	.pill.bad { color: var(--red); border-color: rgba(248, 113, 113, 0.5); background: var(--red-dim); }
	.field { display: grid; gap: 6px; margin-bottom: 16px; }
	.field label { font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.field input {
		width: 100%; min-height: 50px; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line-2);
		background: #06101d; color: var(--text); font-size: 16px; font-family: var(--sans);
	}
	.field input:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px var(--cyan-dim); }
	.field input.mono { font-family: var(--mono); }
	.field .hint { font-size: 12px; color: var(--dim); }
	.field .ferr { font-size: 13px; color: var(--red); min-height: 0; }
	.field.invalid input { border-color: var(--red); }
	.alert { padding: 12px 14px; border-radius: 10px; font-size: 14px; border: 1px solid; }
	.alert.bad { color: var(--red); border-color: rgba(248, 113, 113, 0.4); background: var(--red-dim); }
	.alert.ok { color: var(--green); border-color: rgba(34, 197, 94, 0.4); background: var(--green-dim); }
	.alert.info { color: var(--cyan); border-color: rgba(34, 211, 238, 0.35); background: var(--cyan-dim); }
	.hidden { display: none !important; }
	.file { font-family: var(--mono); font-size: 14px; background: #06101d; border: 1px solid var(--line); border-left: 3px solid var(--orange); padding: 10px 12px; border-radius: 8px; word-break: break-all; color: #ffd9a0; }
	.flag { font-family: var(--mono); font-weight: 700; color: var(--green); word-break: break-all; }
	#toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%) translateY(120px); z-index: 50; background: var(--panel-2); border: 1px solid var(--line-2); color: var(--text); padding: 12px 18px; border-radius: 10px; font-size: 14px; transition: transform 0.25s ease, opacity 0.25s ease; max-width: calc(100vw - 32px); opacity: 0; visibility: hidden; }
	#toast.show { transform: translateX(-50%) translateY(0); opacity: 1; visibility: visible; }
	@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
