---
import CtfLayout from '../../layouts/CtfLayout.astro';
---

<CtfLayout title="Live SOC Leaderboard · NMT" wide bodyClass="lb">
	<header class="lb-head">
		<div>
			<p class="eyebrow">OPSWAT Academy × New Mexico Tech · Can You Trust This File?</p>
			<h1 id="lb-title">LIVE SOC LEADERBOARD</h1>
		</div>
		<div class="head-right">
			<span id="mode" class="pill live">● Live</span>
			<div class="join mono">
				<img src="/ctf/qr.svg" alt="QR code to irfanshakeel.com/ctf" width="84" height="84" />
				<span>JOIN<br /><b>irfanshakeel.com/ctf</b></span>
			</div>
		</div>
	</header>

	<div id="frozen" class="frozen hidden">
		<div class="fz-title">LEADERBOARD FROZEN</div>
		<div class="fz-sub">Final submissions are still being accepted.</div>
	</div>

	<section id="podium" class="podium hidden"></section>

	<div class="lb-grid">
		<section class="board card">
			<table>
				<thead>
					<tr><th class="c-rank">Rank</th><th>Analyst</th><th class="num">Score</th><th class="num">Solved</th></tr>
				</thead>
				<tbody id="rows">
					<tr><td colspan="4" class="empty">Waiting for analysts…</td></tr>
				</tbody>
			</table>
		</section>

		<aside class="side">
			<div class="tiles">
				<div class="tile"><span class="k">Analysts</span><span class="v mono" id="m-analysts">0</span></div>
				<div class="tile"><span class="k">Submissions</span><span class="v mono" id="m-subs">0</span></div>
				<div class="tile"><span class="k">Solves</span><span class="v mono" id="m-solves">0</span></div>
				<div class="tile time"><span class="k">Time remaining</span><span class="v mono" id="m-time">--:--</span></div>
			</div>

			<div class="card progress">
				<p class="eyebrow">Case progress</p>
				<div id="progress"></div>
			</div>

			<div class="card latest">
				<p class="eyebrow">Latest captures</p>
				<ul id="latest"><li class="muted">No captures yet.</li></ul>
			</div>
		</aside>
	</div>
</CtfLayout>

<script>
	import { api, syncClock, remainingMs, fmtClock, esc } from '../../scripts/ctf-client.js';

	const $ = (id: string) => document.getElementById(id)!;
	const MEDAL = ['🥇', '🥈', '🥉'];
	let state: any = null;
	let lastSig = '';

	function render(data: any) {
		const { mode, board } = data;
		state = data.state;
		syncClock(state.serverNow);

		const m = $('mode');
		if (mode === 'final') { m.textContent = 'Final results'; m.className = 'pill ok'; }
		else if (mode === 'frozen') { m.textContent = '❄ Frozen'; m.className = 'pill warn'; }
		else if (!state.started) { m.textContent = 'Waiting to start'; m.className = 'pill'; }
		else if (!state.isOpen) { m.textContent = 'Submissions closed'; m.className = 'pill warn'; }
		else { m.textContent = '● Live'; m.className = 'pill live'; }

		document.body.classList.toggle('is-frozen', mode === 'frozen');
		document.body.classList.toggle('is-final', mode === 'final');
		$('frozen').classList.toggle('hidden', mode !== 'frozen');
		$('lb-title').textContent = mode === 'final' ? 'FINAL RESULTS' : 'LIVE SOC LEADERBOARD';

		const sig = JSON.stringify([mode, board.leaders, board.stats, board.progress, board.latest]);
		if (sig === lastSig) return;
		lastSig = sig;

		const L = board.leaders as any[];
		// Podium for the final reveal
		const pod = $('podium');
		if (mode === 'final' && L.length) {
			const order = [1, 0, 2].filter((i) => L[i]);
			pod.innerHTML = order
				.map((i) => `<div class="pd pd-${i + 1}"><div class="medal">${MEDAL[i]}</div><div class="pd-handle mono">${esc(L[i].handle)}</div><div class="pd-score mono">${L[i].score} pts · ${L[i].solved}/4</div><div class="pd-block">${i + 1}</div></div>`)
				.join('');
			pod.classList.remove('hidden');
		} else pod.classList.add('hidden');

		$('rows').innerHTML = L.length
			? L.map((r) => `<tr class="${r.rank <= 3 ? 'top top-' + r.rank : ''}"><td class="c-rank">${r.rank <= 3 ? MEDAL[r.rank - 1] : '<span class="mono">' + r.rank + '</span>'}</td><td class="handle mono">${esc(r.handle)}</td><td class="num mono score">${r.score}</td><td class="num mono">${r.solved}/4</td></tr>`).join('')
			: '<tr><td colspan="4" class="empty">Waiting for analysts…</td></tr>';

		$('m-analysts').textContent = board.stats.analysts;
		$('m-subs').textContent = board.stats.submissions;
		$('m-solves').textContent = board.stats.solves;

		const denom = Math.max(board.stats.analysts, 1);
		$('progress').innerHTML = board.progress
			.map((p: any) => `<div class="pr"><div class="pr-row"><span class="pr-name">${esc(p.title)}</span><span class="mono">${p.solved} / ${board.stats.analysts}</span></div><div class="bar"><i style="width:${Math.round((p.solved / denom) * 100)}%"></i></div></div>`)
			.join('');

		$('latest').innerHTML = board.latest.length
			? board.latest.map((l: any) => `<li><b class="mono">${esc(l.handle)}</b> captured <span class="cap">${esc(l.challenge)}</span></li>`).join('')
			: '<li class="muted">No captures yet.</li>';
	}

	async function poll() {
		const r = await api('leaderboard');
		if (r.ok) render(r);
	}
	setInterval(() => {
		const ms = state?.started ? remainingMs(state.endsAt) : null;
		const t = $('m-time');
		t.textContent = state?.started && !state.isOpen ? 'CLOSED' : fmtClock(ms);
		t.parentElement!.classList.toggle('low', ms != null && ms < 120000 && state?.isOpen);
	}, 250);
	poll();
	setInterval(poll, 2500);
</script>

<style is:global>
	body.lb { font-size: 18px; }
	.lb-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 20px; }
	.lb-head h1 { font-size: clamp(34px, 4.4vw, 68px); font-weight: 900; letter-spacing: -0.02em; margin-top: 6px; }
	.head-right { display: flex; align-items: center; gap: 20px; }
	.head-right .pill { font-size: 14px; padding: 8px 14px; }
	.join { display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--muted); letter-spacing: 0.08em; }
	.join b { color: var(--text); font-size: 15px; letter-spacing: 0; }
	.join img { background: #fff; border-radius: 6px; padding: 4px; }
	.lb-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(320px, 1fr); gap: 20px; align-items: start; }
	.board { padding: 8px 8px 4px; }
	table { width: 100%; border-collapse: collapse; }
	th { text-align: left; font-family: var(--mono); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); padding: 10px 16px; border-bottom: 1px solid var(--line); }
	td { padding: 9px 16px; border-bottom: 1px solid rgba(31, 58, 92, 0.6); font-size: clamp(18px, 1.6vw, 26px); }
	.num { text-align: right; }
	.c-rank { width: 90px; font-size: 26px; }
	th.c-rank { font-size: 13px; }
	.handle { font-weight: 700; }
	.score { color: var(--cyan); font-weight: 800; }
	tr.top td { font-size: clamp(22px, 2vw, 32px); }
	tr.top-1 { background: linear-gradient(90deg, rgba(251, 191, 36, 0.16), transparent); }
	tr.top-1 .handle { color: var(--gold); }
	tr.top-2 { background: linear-gradient(90deg, rgba(203, 213, 225, 0.12), transparent); }
	tr.top-3 { background: linear-gradient(90deg, rgba(217, 144, 90, 0.14), transparent); }
	.empty { text-align: center; color: var(--muted); padding: 40px; }
	.side { display: grid; gap: 16px; }
	.tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
	.tile { background: linear-gradient(180deg, var(--panel), var(--bg-2)); border: 1px solid var(--line); border-radius: var(--r); padding: 14px 16px; display: grid; gap: 4px; }
	.tile .k { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
	.tile .v { font-size: clamp(30px, 3vw, 48px); font-weight: 800; }
	.tile.time .v { color: var(--cyan); }
	.tile.low .v { color: var(--orange); }
	.progress, .latest { padding: 16px 18px; }
	.pr { margin-top: 12px; }
	.pr-row { display: flex; justify-content: space-between; font-size: 16px; margin-bottom: 6px; }
	.pr-name { font-weight: 700; letter-spacing: 0.03em; }
	.bar { height: 10px; border-radius: 99px; background: #06101d; border: 1px solid var(--line); overflow: hidden; }
	.bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--cyan), #67e8f9); transition: width 0.6s ease; }
	.latest ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 8px; font-size: 17px; }
	.latest b { color: var(--text); }
	.latest .cap { color: var(--green); font-weight: 700; }
	.frozen { text-align: center; padding: 22px; margin-bottom: 20px; border: 2px solid var(--orange); border-radius: var(--r); background: rgba(245, 158, 11, 0.08); }
	.fz-title { font-size: clamp(36px, 5vw, 72px); font-weight: 900; color: var(--orange); letter-spacing: 0.04em; }
	.fz-sub { font-size: clamp(18px, 1.8vw, 28px); margin-top: 4px; }
	body.is-frozen .lb-grid { opacity: 0.55; filter: saturate(0.5); }
	.podium { display: flex; justify-content: center; align-items: flex-end; gap: 24px; margin: 8px 0 28px; }
	.pd { text-align: center; width: min(28vw, 340px); }
	.medal { font-size: 56px; }
	.pd-handle { font-size: clamp(22px, 2.6vw, 40px); font-weight: 800; margin: 4px 0; word-break: break-all; }
	.pd-score { color: var(--muted); font-size: 18px; margin-bottom: 10px; }
	.pd-block { border-radius: 10px 10px 0 0; font-family: var(--mono); font-weight: 900; font-size: 44px; color: #04121f; display: flex; align-items: center; justify-content: center; }
	.pd-1 .pd-block { height: 150px; background: var(--gold); }
	.pd-2 .pd-block { height: 110px; background: var(--silver); }
	.pd-3 .pd-block { height: 80px; background: var(--bronze); }
	.pd-1 .pd-handle { color: var(--gold); }
	@media (max-width: 900px) {
		.shell.wide { padding: 16px; }
		.lb-grid { grid-template-columns: 1fr; }
		.lb-head { flex-direction: column; }
		.join img { width: 64px; height: 64px; }
		.c-rank { width: 56px; }
		td, th { padding: 8px 10px; }
		.podium { gap: 8px; }
		.pd { width: 31%; }
		.medal { font-size: 32px; }
		.pd-handle { font-size: 15px; }
		.pd-score { font-size: 12px; }
		.pd-block { font-size: 28px; }
		.pd-1 .pd-block { height: 90px; } .pd-2 .pd-block { height: 66px; } .pd-3 .pd-block { height: 48px; }
		td, tr.top td { font-size: 16px; }
		.c-rank, td.c-rank { font-size: 18px; width: 44px; }
		.join b { font-size: 13px; }
		.head-right { gap: 12px; flex-wrap: wrap; }
		.tile .v { font-size: 28px; }
	}
</style>
