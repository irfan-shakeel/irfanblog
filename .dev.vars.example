# Copy to .dev.vars for local development (gitignored). Never commit real values.
CTF_ADMIN_PASSWORD=change-me
CTF_SESSION_SECRET=generate-a-long-random-string-here
# Answer key: {"<challenge>":{"q1":"<option id>","q2":"...","q3":"..."}, ...} for identity, blind, capable, objective, boundary; multi-select answers are sorted arrays
CTF_ANSWER_KEY={}
CTF_FLAG_IDENTITY=FLAG{...}
CTF_FLAG_BLIND=FLAG{...}
CTF_FLAG_CAPABLE=FLAG{...}
CTF_FLAG_OBJECTIVE=FLAG{...}
CTF_FLAG_BOUNDARY=FLAG{...}
