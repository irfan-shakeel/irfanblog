# Copy to .dev.vars for local development (gitignored). Never commit real values.
CTF_ADMIN_PASSWORD=change-me
CTF_SESSION_SECRET=generate-a-long-random-string-here
# Answer key: {"<challenge>":{"q1":"<option id>","q2":"...","q3":"..."}, ...} for impostor, box, green, dlp
CTF_ANSWER_KEY={}
CTF_FLAG_IMPOSTOR=FLAG{...}
CTF_FLAG_BOX=FLAG{...}
CTF_FLAG_GREEN=FLAG{...}
CTF_FLAG_DLP=FLAG{...}
